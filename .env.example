PORT=5000
CORS_ORIGIN=http://localhost:5173
# Supabase Postgres pooler untuk runtime dan direct connection untuk migrasi.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
VECTOR_DIMENSION=768
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me
AI_MODEL_NAME=google/siglip-base-patch16-224
IMAGE_MAX_SIZE_MB=5
AI_SERVICE_TIMEOUT_MS=60000

# Ambang pencarian barang by gambar (cosine distance, 0 = paling mirip).
# Lihat src/utils/imageSearchGate.js untuk arti tiap nilai.
IMAGE_SEARCH_LIMIT=12
IMAGE_SEARCH_NEAR_LIMIT=6
IMAGE_SEARCH_ABS_MAX=0.45
IMAGE_SEARCH_ABS_FLOOR=0.18
IMAGE_SEARCH_RATIO_MAX=0.60
# Cadangan pencarian via deskripsi teks (belum diimplementasikan di backend).
IMAGE_SEARCH_TEXT_ABS_MAX=0.945
IMAGE_SEARCH_TEXT_LIMIT=6
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=28800