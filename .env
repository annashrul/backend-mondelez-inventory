CLOUDINARY_URL="cloudinary://528556199126989:A96AnqKz0mMb_bfmiSO_EjWOEfQ@dxjazxzn4"

# Search-by-Image (vektor pgvector via SigLIP)
AI_SERVICE_URL=http://localhost:8000

AI_SERVICE_TOKEN=
AI_MODEL_NAME=google/siglip-base-patch16-224
VECTOR_DIMENSION=768
IMAGE_SEARCH_LIMIT=12
# Gate hasil = relatif (ratio ke median) + plafon/lantai absolut.
# Penjelasan & angka kalibrasi ada di .env.example dan image-search.gate.ts.
IMAGE_SEARCH_RATIO_MAX=0.60
IMAGE_SEARCH_ABS_MAX=0.45
IMAGE_SEARCH_ABS_FLOOR=0.18
# Kandidat "Gambar serupa" saat tidak ada yang lolos gate. 0 = matikan.
IMAGE_SEARCH_NEAR_LIMIT=6
# Jalur TEKS (text tower SigLIP → foto produk). Skala jarak BEDA dari gambar.
IMAGE_SEARCH_TEXT_ABS_MAX=0.945
IMAGE_SEARCH_TEXT_LIMIT=6
IMAGE_MAX_SIZE_MB=5
AI_SERVICE_TIMEOUT_MS=120000
EMBEDDING_SWEEP_ENABLED=true
EMBEDDING_SWEEP_BATCH=16